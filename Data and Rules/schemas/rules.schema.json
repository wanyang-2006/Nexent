{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundtrace:schema:rules",
  "title": "rules/rules_vN.yaml（用 yaml.safe_load 读入后校验）",
  "type": "object",
  "required": ["spec_version", "version", "based_on", "source", "evidence_limit", "trace", "rules"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "version": {"$ref": "urn:fundtrace:schema:common#/$defs/rule_version"},
    "based_on": {"anyOf": [{"$ref": "urn:fundtrace:schema:common#/$defs/rule_version"}, {"type": "null"}]},
    "source": {"type": "string"},
    "evidence_limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "trace": {
      "type": "object",
      "required": ["window_from", "edge_types", "seed_min_amount", "min_chain_amount", "conserve_ratio"],
      "additionalProperties": false,
      "properties": {
        "window_from": {"type": "string", "pattern": "^R\\d{2,}\\.[a-z_]+$"},
        "edge_types": {"type": "array", "minItems": 1, "items": {"$ref": "urn:fundtrace:schema:common#/$defs/tx_type"}},
        "seed_min_amount": {"type": "number", "minimum": 0},
        "min_chain_amount": {"type": "number", "minimum": 0},
        "conserve_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_component_edges": {"type": "integer", "minimum": 2}
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "name", "type", "level", "impl", "params", "aligned_to", "desc"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"$ref": "urn:fundtrace:schema:common#/$defs/rule_id"},
          "name": {"type": "string", "minLength": 1},
          "type": {"$ref": "urn:fundtrace:schema:common#/$defs/rule_type"},
          "level": {"$ref": "urn:fundtrace:schema:common#/$defs/rule_level"},
          "impl": {"type": "string", "pattern": "^[a-z_]+$"},
          "in_types": {"type": "array", "minItems": 1, "items": {"$ref": "urn:fundtrace:schema:common#/$defs/tx_type"}},
          "out_types": {"type": "array", "minItems": 1, "items": {"$ref": "urn:fundtrace:schema:common#/$defs/tx_type"}},
          "params": {"type": "object", "additionalProperties": {"type": "number"}},
          "aligned_to": {"type": "string", "minLength": 1},
          "desc": {"type": "string", "minLength": 1},
          "state": {"enum": ["active", "deprecated"]}
        }
      }
    }
  }
}
